{
    "manifest_version": 3,
    "name": "Leetify",
    "version": "2.0.0",
    "description": "Automatically save accepted LeetCode solutions to GitHub.",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "https://leetcode.com/*",
        "https://api.github.com/*"
    ],

    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Leetify",
        "default_icon": {
            "16": "assets/icon.png",
            "48": "assets/icon.png",
            "128": "assets/icon.png"
        }
    },

    "icons": {
        "16": "assets/icon.png",
        "48": "assets/icon.png",
        "128": "assets/icon.png"
    },

    "background": {
        "service_worker": "background/background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/*"
            ],
            "js": [
                "content/problemDetails.js",
                "content/solutionGetter.js",
                "content/submissionChecker.js"
            ]
        }
    ]
}